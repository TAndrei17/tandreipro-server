# Local backend configuration template. Replace placeholders with local values.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Optional: number of reverse proxies in front of the server (e.g. 1). Leave empty if none.
TRUST_PROXY=

DATABASE_URL=postgresql://user:password@localhost:5432/database_name
JWT_SECRET=replace-with-a-unique-local-random-secret
TURNSTILE_SECRET_KEY=replace-with-a-local-turnstile-secret-key

ADMIN_NAME=Local Admin
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-a-local-only-password
